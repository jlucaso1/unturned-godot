<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>UnturnedGodot</RootNamespace>
    <!-- Pure logic only: no engine dependency, so it can run under xUnit. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GodotSharp" Version="4.7.0" />
    <!-- LZMA decode for the masterbundle's single data block; parity-critical mesh/tree parsing stays ours. -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.10" />
  </ItemGroup>
</Project>
