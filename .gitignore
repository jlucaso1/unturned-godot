# Godot 4+ specific ignores
.godot/
/android/

# .NET build output
bin/
obj/
*.user

# Centralized build output (core/tests binaries, debug + release, game exports).
# Keep the export dir skeleton so Godot's export (which won't create it) works on a fresh clone.
/build/**
!/build/export/
!/build/export/linux/
!/build/export/linux/.gitkeep

# Godot 4.x stores export secrets (keystore/SSH passwords) here — never commit it
export_credentials.cfg

# Test / coverage artifacts
[Tt]est[Rr]esults/
coverage/
*.coverage
*.cobertura.xml
coverage.opencover.xml
coverage.json

# Profiling traces (dotnet-trace / GPU benchmark output)
*.nettrace
*.speedscope.json

# Rider / VS / editors
.idea/
.vs/
.vscode/

# OS
.DS_Store
