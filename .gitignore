# Godot 4+ specific ignores
.godot/
/android/

# .NET build output
bin/
obj/
*.user

# Centralized build output (core/tests binaries, debug + release, game exports).
# Keep the export dir skeleton so Godot's export (which won't create it) works on a fresh clone.
/build/**
!/build/export/
!/build/export/linux/
!/build/export/linux/.gitkeep
!/build/export/windows/
!/build/export/windows/.gitkeep
!/build/export/macos/
!/build/export/macos/.gitkeep

# Godot 4.x stores export secrets (keystore/SSH passwords) here — never commit it
export_credentials.cfg

# Backup the Godot editor drops when it rewrites the csproj (e.g. bumping Godot.NET.Sdk)
*.csproj.old

# Test / coverage artifacts
[Tt]est[Rr]esults/
coverage/
*.coverage
*.cobertura.xml
coverage.opencover.xml
coverage.json

# Benchmark baselines are per-machine: they hold wall-clock timings measured on whoever ran them, and
# the only sound way to read one is "me, on this machine, before vs after my change". Shared across
# machines they are noise — a 4-vCPU container reports +9760% on build.total.ms against a desktop's
# numbers — and a committed one silently rots as the code moves on. Record your own with
# `--write-baseline`. The machine-independent counts live in bench/structural/ instead, and those ARE
# committed: see scripts/check-structural-metrics.sh.
/bench/baseline/

# Profiling traces (dotnet-trace, heaptrack, valgrind, perf, AMD RGP)
*.nettrace
*.speedscope.json
heaptrack.*.zst
*.heaptrack
massif.out.*
callgrind.out.*
perf.data*
*.rgp

# Rider / VS / editors
.idea/
.vs/
.vscode/

# OS
.DS_Store
