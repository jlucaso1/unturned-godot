<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Only nuget.org here: a local source that does not exist fails the entire restore (NU1301),
         so no machine-specific path may live in the versioned config.

         Distro Godot builds (godot-mono on Arch/CachyOS, Godot's own editor download, ...) ship their
         GodotSharp/Godot.NET.Sdk nupkgs locally, which you need when that exact version is not on
         nuget.org yet. Register it per machine instead — it merges with this file:

           dotnet nuget add source /usr/lib/godot-mono/GodotSharp/Tools/nupkgs -n GodotLocal
    -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
