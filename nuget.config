<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- godot-mono-bin on CachyOS installs under /usr/lib/godot-mono (the old Arch package used
         /usr/lib/godot); update this if the distro package layout changes again. -->
    <add key="GodotLocal" value="/usr/lib/godot-mono/GodotSharp/Tools/nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
